{
  "name": "air-guitar-hero",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-native five-lane guitar game with an original synthesized setlist.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "verify:screenshots": "tsx scripts/verify-screenshots.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:content && npm run verify:screenshots",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "serve:prod": "vite preview --port 4317 --strictPort"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
